# ---------------------------------------------------------------------------
# GTX Exchange — environment configuration
# Copy this file to .env before running `docker compose up --build`
# ---------------------------------------------------------------------------

# PostgreSQL credentials — docker-compose.yml builds both the postgres
# service and every other service's DATABASE_URL from these three, so they
# only need to be set once here. No fallback exists on purpose: the
# official postgres image refuses to start with an empty password.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# PostgreSQL connection string (used directly outside docker-compose, e.g.
# `npx prisma migrate dev` from the host). When running via docker-compose,
# services build their own DATABASE_URL from POSTGRES_* above instead.
DATABASE_URL="postgresql://gtx:gtx_password@localhost:5432/gtx_exchange"

# JWT secrets — MUST be at least 32 random characters each. No fallback
# exists: the app refuses to start without these (see lib/env.ts).
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Admin Panel: key for the SUPER_ADMIN "Show password" feature (see
# lib/auth/password-crypto.ts) — MUST be at least 32 random characters.
# Generate with: openssl rand -base64 48
# No fallback exists on purpose: if this is unset, password viewing is
# disabled with a clear error instead of using an insecure default key.
# Never commit the real value — set it via your hosting provider's
# environment variables in production.
PASSWORD_ENCRYPTION_KEY="change_this_to_a_random_32plus_char_secret"

NODE_ENV=production

# Whether this deployment sits behind a reverse proxy trusted to set
# X-Forwarded-For / X-Real-IP / a geo-IP country header itself (nginx,
# Cloudflare, Vercel, a load balancer, ...). Leave unset/false while `web`
# is exposed directly, as it is in this docker-compose.yml by default —
# trusting these headers with no real proxy in front would let any client
# claim to be any IP or country it likes. Gates two independent signals
# that share this same trust boundary: the first-deposit-bonus anti-abuse
# IP check (lib/security/client-ip.ts) and the locale auto-detection
# country fallback (lib/security/geo.ts) — nothing else in the app
# depends on it.
TRUST_PROXY_HEADERS=false

# Outbound email (password reset, password-changed, email-change
# confirmation — see lib/email/mailer.ts). All optional: leave unset and
# the app logs the message instead of sending it (fine for local dev).
# To actually deliver email, fill these in with a real SMTP provider
# (e.g. a transactional-email service's SMTP credentials, or Gmail with
# an app password) and make sure they're forwarded to the `web` service
# in docker-compose.yml (already wired — just needs values here).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GTX Exchange <no-reply@gtx.exchange>"

# The public URL used to build links inside outgoing emails (password
# reset, email-change confirmation). Required in production — the app
# refuses to start without a real (non-localhost) value once NODE_ENV is
# "production" (see lib/env.ts). Safe to leave unset for local dev, which
# still defaults to http://localhost:3000.
APP_URL=

# URL the browser uses to reach the WebSocket market-data relay.
# Use ws://localhost:8080 for local docker-compose usage;
# use wss://your-domain for a production deployment behind TLS.
NEXT_PUBLIC_WS_URL="ws://localhost:8080"

# Port the WS relay service listens on internally.
WS_PORT=8080

# The GTX support Telegram account's t.me link — /contacts's Telegram
# card links here. The official public username is @gtx_sup. If this is
# ever unset, the button falls back to a disabled state rather than
# linking to an invented username (see lib/support/config.ts).
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=https://t.me/gtx_sup
