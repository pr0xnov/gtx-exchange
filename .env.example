# ---------------------------------------------------------------------------
# GTX Exchange — environment configuration
# Copy this file to .env before running `docker compose up --build`
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# When running via docker-compose, "postgres" resolves to the postgres service.
DATABASE_URL="postgresql://gtx:gtx_password@postgres:5432/gtx_exchange"

# JWT secrets — MUST be at least 32 random characters each in production.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change_this_access_secret_to_something_random_32chars"
JWT_REFRESH_SECRET="change_this_refresh_secret_to_something_random_32"

NODE_ENV=production

# URL the browser uses to reach the WebSocket market-data relay.
# Use ws://localhost:8080 for local docker-compose usage;
# use wss://your-domain for a production deployment behind TLS.
NEXT_PUBLIC_WS_URL="ws://localhost:8080"

# Port the WS relay service listens on internally.
WS_PORT=8080
