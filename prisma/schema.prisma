generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// USER & AUTH
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

model User {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String   @unique
  passwordHash      String
  // AES-256-GCM-encrypted copy of the current plaintext password (see
  // lib/auth/password-crypto.ts) — used ONLY by SUPER_ADMIN's "Show
  // password" feature in the Admin Panel. Never read by login/auth, which
  // exclusively checks passwordHash above. Null for any account created or
  // last password-changed before this feature existed (a bcrypt hash can't
  // be reversed into this) or while PASSWORD_ENCRYPTION_KEY isn't
  // configured — the UI shows "Not available" for those until the next
  // password change/reset backfills it.
  encryptedPassword String?
  accountType       String   @default("Standard")
  leverageMax       Int      @default(100)
  login             String   @unique @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Admin Panel: role is the sole gate for /admin and /api/admin/** (every
  // admin route re-checks this fresh from the DB via requireAdmin() —
  // never trusts a client-supplied role or an unverified JWT claim).
  // status is the account's own standing, independent of role — a BLOCKED
  // or SUSPENDED account (any role) is refused at login (see
  // app/api/auth/login/route.ts) even with a correct password/2FA.
  role   Role       @default(USER)
  status UserStatus @default(ACTIVE)

  // Email-change verification (Settings > Profile): the new address is
  // held here, unapplied, until the token sent to it is confirmed — the
  // live `email` above never changes until then. One pending change at a
  // time; requesting a new one overwrites these.
  pendingEmail         String?
  emailChangeTokenHash String?   @unique
  emailChangeExpiresAt DateTime?

  // Forgot-password ("/login" -> "Forgot password?"): same shape/reasoning
  // as the email-change token above — only a SHA-256 hash is ever stored,
  // never the raw token, so a DB read alone can't be turned into a working
  // reset link. One-time use (cleared the moment it's redeemed) and
  // short-lived (see TOKEN_TTL_MS in app/api/auth/forgot-password/route.ts).
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  // KYC personal info (Account verification): filled in once, at
  // submission time (see app/api/verification/route.ts) — nothing else in
  // the schema captured these before. Full name/email are NOT duplicated
  // here; the verification UI reads those straight off firstName/
  // lastName/email above, per the "don't invent data, reuse what exists"
  // rule this feature was built under. Null until the user's first
  // verification submission.
  country     String?
  dateOfBirth DateTime?
  address     String?

  // Referral program: generated once server-side at registration (see
  // app/api/auth/register/route.ts + lib/referral/code.ts), permanent —
  // no route ever regenerates or edits it after creation.
  referralCode String @unique

  // Who referred this user, set ONLY at registration from an optional,
  // validated referral code (see registerSchema) — never null-to-non-null
  // afterward, so the relationship is immutable once created. Self-
  // referral is structurally impossible here (the referrer must already
  // exist; a brand-new user can't yet know its own not-yet-generated
  // code) and app/lib/referral/reward.ts additionally refuses to reward a
  // referrer that equals the referred user, as defense in depth.
  referredById String?
  referredBy   User?   @relation("ReferralInvite", fields: [referredById], references: [id])
  referrals    User[]  @relation("ReferralInvite")

  // Anti-abuse signal for the first-deposit bonus (see
  // lib/bonus/first-deposit.ts) — NOT an identity mechanism, just a
  // fraud-detection input. Updated on every successful registration/login
  // (see lib/security/client-ip.ts) so it reflects the most recent known
  // connection, not just the one at signup. lastKnownIp is null whenever
  // it couldn't be verified (no trusted reverse proxy configured — see
  // TRUST_PROXY_HEADERS); lastKnownDeviceHash is a hash of the browser's
  // own User-Agent header, never a fingerprint.
  lastKnownIp         String?
  lastKnownDeviceHash String?

  wallet        Wallet?
  orders        Order[]
  positions     Position[]
  trades        Trade[]
  transactions  Transaction[]
  documents     VerificationDocument[]
  notifications Notification[]
  settings      UserSettings?
  sessions      Session[]
  refreshTokens RefreshToken[]
  spotWallets   SpotWallet[]
  spotOrders    SpotOrder[]

  // Admin Panel relations — named because a User can appear on both sides
  // (an admin's own account still has the User-side relations above too).
  balanceAdjustmentsReceived BalanceAdjustment[] @relation("BalanceAdjustmentUser")
  balanceAdjustmentsMade     BalanceAdjustment[] @relation("BalanceAdjustmentAdmin")
  auditLogEntries            AuditLog[]          @relation("AuditLogAdmin")

  // See ReferralReward below — a User can be the referrer on many reward
  // rows but the referred party on at most one (its referredUserId is
  // @unique, enforcing "one signup reward per referred user" at the DB
  // level).
  referralRewardsGiven   ReferralReward[]   @relation("ReferralRewardReferrer")
  referralRewardReceived ReferralReward?    @relation("ReferralRewardReferred")
  firstDepositBonus      FirstDepositBonus?

  supportConversations SupportConversation[]

  @@index([email])
  @@index([role])
  @@index([referredById])
}

model UserSettings {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  language        String  @default("en")
  theme           String  @default("dark")
  twoFactorOn     Boolean @default(false)
  // AES-256-GCM-encrypted TOTP secret (see lib/auth/crypto.ts) — set once
  // Enable 2FA's setup step is confirmed with a valid code, cleared on
  // disable. Never the raw base32 secret at rest, and never returned to
  // the client after setup completes.
  twoFactorSecret String?
  notifyEmail     Boolean @default(true)
  notifyPush      Boolean @default(true)
  notifyMarket    Boolean @default(false)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([token])
}

// ---------------------------------------------------------------------------
// WALLET / FINANCE
// ---------------------------------------------------------------------------

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(20, 8)
  credit    Decimal  @default(0) @db.Decimal(20, 8)
  currency  String   @default("USDT")
  updatedAt DateTime @updatedAt
}

model Transaction {
  id                 String                @id @default(cuid())
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               TransactionType
  method             String?
  // Only meaningful for a USDT DEPOSIT — which of the three fixed
  // networks (BSC/TRX/ETH — see lib/deposit/usdt-networks.ts) the user
  // was shown as the receiving address. The address itself is NOT
  // duplicated here — it's derived from this code via that same static
  // config, both on the Deposit page and in Admin's per-user Deposits
  // tab, so there is exactly one place to change an address.
  network            String?
  // Only meaningful for a USDT DEPOSIT — the payment-confirmation
  // screenshot required before a deposit request can be created (see
  // app/api/deposit/route.ts). Same storage technique as
  // VerificationDocument.fileData/mimeType (raw bytes directly in
  // Postgres — no S3/object storage exists anywhere in this project),
  // just placed directly on Transaction rather than a separate table,
  // matching the existing precedent of type-specific nullable columns
  // already here (method/network/direction).
  proofFileName      String?
  proofData          Bytes?
  proofMimeType      String?
  // Only meaningful for a USDT WITHDRAWAL — the user-entered destination
  // wallet address for the chosen `network`, unlike Deposit's fixed
  // addresses above (see lib/deposit/usdt-networks.ts) there is no static
  // config to derive this from, so it has to be persisted per-request for
  // Admin to see and pay out to.
  destinationAddress String?
  amount             Decimal               @db.Decimal(20, 8)
  // Every pre-existing TransactionType (DEPOSIT/WITHDRAWAL/BONUS/
  // TRADE_SETTLEMENT) only ever moved the futures-margin Wallet, which is
  // implicitly USDT-only — this default backfills that for every row that
  // predates ADMIN_BALANCE_ADJUSTMENT (the first type that can touch any
  // SpotWallet currency) without a data migration.
  asset              String                @default("USDT")
  // Only meaningful for ADMIN_BALANCE_ADJUSTMENT so far — the older types
  // each have a fixed, implied sign already baked into how the UI reads
  // `type` (see components/dashboard/history-table.tsx's TYPE_SIGN), so
  // backfilling this for them would be redundant, not corrective.
  direction          TransactionDirection?
  status             TransactionStatus     @default(COMPLETED)
  createdAt          DateTime              @default(now())
  // Unused. Was an admin-review "seen" marker for an earlier unread-
  // messages framing of the Admin Panel's request badges; that framing
  // was dropped (badges now mean "still PENDING", not "not yet opened" —
  // see lib/admin/user-summary.ts) so nothing reads or writes this column
  // anymore. Left in place rather than migrated out, since removing it
  // isn't needed for anything currently broken.
  adminViewedAt      DateTime?

  balanceAdjustment BalanceAdjustment?

  @@index([userId, createdAt])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BONUS
  TRADE_SETTLEMENT
  ADMIN_BALANCE_ADJUSTMENT
  REFERRAL_BONUS
  FIRST_DEPOSIT_BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

/**
 * One row per referred user who has EVER triggered the signup referral
 * reward — at most one, ever, enforced by referredUserId's @unique
 * constraint (see lib/referral/reward.ts, which relies on this exact
 * constraint for idempotency: creating this row is the atomic "claim" a
 * second qualifying deposit or a retried/duplicate deposit approval
 * cannot win twice). depositTransactionId records which of the referred
 * user's deposits triggered it; rewardTransactionId links to the
 * REFERRAL_BONUS Transaction credited to the referrer — nullable only for
 * the instant between this row being created (the atomic claim) and that
 * Transaction being created and linked back, both inside the same Prisma
 * $transaction as the deposit approval itself, so it is never observably
 * null outside that transaction.
 */
model ReferralReward {
  id                   String   @id @default(cuid())
  referrerId           String
  referrer             User     @relation("ReferralRewardReferrer", fields: [referrerId], references: [id])
  referredUserId       String   @unique
  referredUser         User     @relation("ReferralRewardReferred", fields: [referredUserId], references: [id])
  depositTransactionId String   @unique
  depositAmount        Decimal  @db.Decimal(20, 8)
  rewardAmount         Decimal  @db.Decimal(20, 8)
  rewardTransactionId  String?
  createdAt            DateTime @default(now())

  @@index([referrerId])
}

/**
 * One row per user who has EVER triggered the 20% first-deposit bonus —
 * at most one, ever, enforced by userId's @unique constraint (see
 * lib/bonus/first-deposit.ts, which relies on this exact constraint for
 * idempotency the same way ReferralReward.referredUserId does: creating
 * this row is the atomic "claim" a second approved deposit or a
 * retried/duplicate deposit approval cannot win twice). No cap on
 * bonusAmount — the 20% first-deposit bonus is currently uncapped, unlike
 * the referral reward. rewardTransactionId mirrors ReferralReward's own
 * nullable-until-linked field for the same reason (see its comment).
 */
model FirstDepositBonus {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  depositTransactionId String   @unique
  depositAmount        Decimal  @db.Decimal(20, 8)
  bonusAmount          Decimal  @db.Decimal(20, 8)
  bonusTransactionId   String?
  createdAt            DateTime @default(now())

  // Anti-abuse audit trail — the depositor's lastKnownIp/lastKnownDeviceHash
  // (see User above) AT THE MOMENT this claim was made, frozen here so a
  // later change to the user's own recorded IP never rewrites history.
  // reviewReason is non-null exactly when the claim was withheld instead of
  // paid (bonusTransactionId stays null forever in that case, unlike the
  // brief in-transaction gap before it's normally linked) — e.g.
  // "DUPLICATE_IP" when another account already collected this bonus from
  // the same recorded IP. Never surfaced to end users; for admin review only.
  claimIp         String?
  claimDeviceHash String?
  reviewReason    String?

  @@index([claimIp])
}

// ---------------------------------------------------------------------------
// ADMIN PANEL
// ---------------------------------------------------------------------------

/**
 * The admin-facing record of a single manual balance correction — who did
 * it, to whom, why. Deliberately its own model rather than cramming
 * admin-only columns (adminId, reason) onto the general-purpose
 * Transaction: every OTHER transaction type has neither, and this way
 * Transaction stays exactly what every non-admin part of the app already
 * expects. The linked `transaction` row is what makes the adjustment show
 * up in the user's own existing History (see app/api/history) — one
 * financial ledger, not two.
 */
model BalanceAdjustment {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation("BalanceAdjustmentUser", fields: [userId], references: [id], onDelete: Cascade)
  adminId       String
  admin         User                 @relation("BalanceAdjustmentAdmin", fields: [adminId], references: [id])
  asset         String
  direction     TransactionDirection
  amount        Decimal              @db.Decimal(20, 8)
  reason        String
  transactionId String               @unique
  transaction   Transaction          @relation(fields: [transactionId], references: [id])
  createdAt     DateTime             @default(now())

  @@index([userId])
  @@index([adminId])
}

/**
 * Append-only security/administrative event log — no route in this app
 * ever updates or deletes a row here (see app/api/admin/audit-log), which
 * is what "append-only" means in practice for a Prisma model with no
 * delete-capable API surface. `adminId` is nullable so this can also
 * record a plain user's own security events (login/logout/password/2FA —
 * see lib/audit/log.ts) without a fake admin actor; `targetUserId` is a
 * plain string, not a relation, so an entry is never at risk of being
 * cascade-deleted or blocked by referential integrity tied to the
 * (currently nonexistent) ability to delete a User.
 */
model AuditLog {
  id           String   @id @default(cuid())
  adminId      String?
  admin        User?    @relation("AuditLogAdmin", fields: [adminId], references: [id])
  targetUserId String?
  action       String
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// MARKET / ASSETS
// ---------------------------------------------------------------------------

model Asset {
  id            String   @id @default(cuid())
  symbol        String   @unique // e.g. BTCUSDT
  displaySymbol String   @default("")
  baseAsset     String
  quoteAsset    String   @default("USDT")
  category      String   @default("Cryptocurrencies")
  lastPrice     Decimal  @default(0) @db.Decimal(20, 8)
  change24h     Decimal  @default(0) @db.Decimal(10, 4)
  updatedAt     DateTime @updatedAt

  orders    Order[]
  positions Position[]
  trades    Trade[]

  @@index([category])
}

// ---------------------------------------------------------------------------
// TRADING
// ---------------------------------------------------------------------------

enum OrderType {
  MARKET
  LIMIT
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  FILLED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset       @relation(fields: [assetId], references: [id])
  type       OrderType
  side       OrderSide
  amount     Decimal     @db.Decimal(20, 8)
  leverage   Int         @default(1)
  limitPrice Decimal?    @db.Decimal(20, 8)
  takeProfit Decimal?    @db.Decimal(20, 8)
  stopLoss   Decimal?    @db.Decimal(20, 8)
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  filledAt   DateTime?

  position Position?

  @@index([userId, status])
}

enum PositionSide {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSED
}

model Position {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset          @relation(fields: [assetId], references: [id])
  orderId          String?        @unique
  order            Order?         @relation(fields: [orderId], references: [id])
  side             PositionSide
  amount           Decimal        @db.Decimal(20, 8)
  leverage         Int            @default(1)
  entryPrice       Decimal        @db.Decimal(20, 8)
  currentPrice     Decimal        @db.Decimal(20, 8)
  takeProfit       Decimal?       @db.Decimal(20, 8)
  stopLoss         Decimal?       @db.Decimal(20, 8)
  margin           Decimal        @db.Decimal(20, 8)
  liquidationPrice Decimal?       @db.Decimal(20, 8)
  status           PositionStatus @default(OPEN)
  realizedPnl      Decimal?       @db.Decimal(20, 8)
  openedAt         DateTime       @default(now())
  closedAt         DateTime?

  trade Trade?

  @@index([userId, status])
}

model Trade {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset        @relation(fields: [assetId], references: [id])
  positionId String?      @unique
  position   Position?    @relation(fields: [positionId], references: [id])
  side       PositionSide
  amount     Decimal      @db.Decimal(20, 8)
  entryPrice Decimal      @db.Decimal(20, 8)
  exitPrice  Decimal      @db.Decimal(20, 8)
  pnl        Decimal      @db.Decimal(20, 8)
  leverage   Int          @default(1)
  closedAt   DateTime     @default(now())

  @@index([userId, closedAt])
}

// ---------------------------------------------------------------------------
// SPOT TRADING
//
// Deliberately separate from Order/Position/Trade above: spot ownership is
// just "how many units of a currency does this user hold", with no
// leverage, margin, or liquidation concept, so it doesn't fit those
// leveraged-trading models. SpotWallet is a per-user, per-currency ledger
// (USDT, BTC, ETH, ...) — entirely separate from the `Wallet` model, which
// is the futures-margin USDT balance. SpotOrder.symbol is a plain string
// (not a relation to Asset) per spec — order rows are a standalone,
// self-contained record of what was requested/filled.
// ---------------------------------------------------------------------------

enum SpotOrderStatus {
  OPEN
  FILLED
  CANCELLED
}

model SpotWallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  String // "USDT", "BTC", "ETH", "BNB", "SOL", "XRP", "ADA", "DOGE", "LTC"
  balance   Decimal  @default(0) @db.Decimal(20, 8) // available
  locked    Decimal  @default(0) @db.Decimal(20, 8) // reserved by this user's own OPEN limit orders
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
}

model SpotOrder {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String // e.g. "BTCUSDT"
  side           OrderSide
  type           OrderType
  price          Decimal         @db.Decimal(20, 8) // limit price, or execution price for MARKET
  quantity       Decimal         @db.Decimal(20, 8)
  filledQuantity Decimal         @default(0) @db.Decimal(20, 8)
  status         SpotOrderStatus @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// VERIFICATION / NOTIFICATIONS
// ---------------------------------------------------------------------------

enum DocumentType {
  IDENTITY
  PROOF_OF_ADDRESS
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationDocument {
  id       String       @id @default(cuid())
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     DocumentType
  fileName String
  // The actual uploaded file — previously this model only ever stored a
  // filename string (the browser's File.name), with the real bytes never
  // leaving the client at all, so there was nothing an admin (or the user)
  // could actually open. Stored directly in Postgres rather than adding
  // new infrastructure (no object storage/S3/Docker volume exists
  // anywhere else in this project) — validated server-side to image/* or
  // application/pdf, capped at 5MB (see app/api/verification/route.ts).
  // Nullable so pre-existing rows (filename-only, from before this field
  // existed) don't need a backfill.
  fileData Bytes?
  mimeType String?

  status          DocumentStatus @default(PENDING)
  // Set only on REJECTED, by the reviewing admin (see
  // app/api/admin/verification/[userId]/route.ts) — the free-text reason
  // shown back to the user on /verification and /account. A fresh
  // resubmission clears it (the whole row is replaced, not patched).
  rejectionReason String?

  uploadedAt    DateTime  @default(now())
  // Unused — see Transaction.adminViewedAt's comment for why.
  adminViewedAt DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// SUPPORT
// ---------------------------------------------------------------------------

enum SupportCategory {
  DEPOSIT
  WITHDRAWAL
  TRADING
  VERIFICATION
  BONUSES
  SECURITY
  OTHER
}

enum SupportConversationStatus {
  OPEN
  CLOSED
}

enum SupportSenderType {
  USER
  ADMIN
}

/**
 * The /contacts support-chat inbox — one row per help request a user has
 * opened, picked from a fixed category list up front (see SupportCategory)
 * so an admin working the queue always knows what it's about before
 * opening it. A user is never restricted to exactly one conversation ever,
 * but app/api/support/conversations/route.ts's POST reuses an existing
 * OPEN one instead of creating a second — the queue is meant to hold at
 * most one active thread per user at a time, not a pile of duplicates.
 * Closing is admin-only (see app/api/admin/support/conversations/[id]);
 * a user's own new message on a CLOSED conversation reopens it (see
 * app/api/support/conversations/[id]/messages/route.ts) — the simplest
 * way to let a resolved-but-not-really conversation come back without a
 * separate "reopen" affordance in the user-facing UI.
 */
model SupportConversation {
  id       String                    @id @default(cuid())
  userId   String
  user     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category SupportCategory
  status   SupportConversationStatus @default(OPEN)
  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/**
 * A single message within a SupportConversation. senderType is the whole
 * authorization story for rendering (never trust a client-supplied
 * "isAdmin" flag) — USER rows are always written by the conversation's own
 * owner (see the ownership check in app/api/support/conversations/[id]/
 * messages/route.ts), ADMIN rows only by an authenticated admin (see
 * app/api/admin/support/conversations/[id]/messages/route.ts). No senderId
 * on ADMIN rows on purpose — replies are shown as "GTX Support", not a
 * named employee, matching the same principle behind never exposing a
 * private employee Telegram account.
 */
model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SupportSenderType
  message        String
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}
